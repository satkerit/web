APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD="your-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bprsbabel.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative SMTP providers:
# Gmail: smtp.gmail.com (port 587, tls)
# Yahoo: smtp.mail.yahoo.com (port 587, tls)
# Outlook: smtp-mail.outlook.com (port 587, tls)
# Mailtrap: sandbox.smtp.mailtrap.io (port 2525)
# Mailgun: smtp.mailgun.org (port 587, tls)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Rate Limiting (requests per minute)
RATE_LIMIT_WEB=120
RATE_LIMIT_ADMIN=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_DOWNLOAD=30
RATE_LIMIT_API=60

# DDoS Protection
DDOS_REQUESTS_PER_SECOND=10
DDOS_REQUESTS_PER_MINUTE=120
DDOS_REQUESTS_PER_HOUR=3000
DDOS_RAPID_FIRE_THRESHOLD=20
DDOS_SAME_ENDPOINT_THRESHOLD=30

# IP Blocking
SECURITY_BLOCK_THRESHOLD=10
SECURITY_BLOCK_DURATION=24
SECURITY_IP_WHITELIST=

# Session Security
SESSION_IDLE_TIMEOUT=30
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
