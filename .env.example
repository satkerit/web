# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# For Production, change to:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_db_bprs
DB_USERNAME=root
DB_PASSWORD=

# For Production, use secure credentials:
# DB_HOST=your_production_host
# DB_DATABASE=your_production_database
# DB_USERNAME=your_production_user
# DB_PASSWORD=your_secure_password

# ===========================================
# SESSION & CACHE CONFIGURATION
# ===========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# For Production, enable secure cookies:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
# 
# DEVELOPMENT (Default):
# Files stored in: storage/app/public
# Accessible via: http://localhost/storage (symlink from public/storage)
# No configuration needed - works out of the box
#
# PRODUCTION (Project outside public_html):
# When your Laravel project is outside public_html, configure these:
#
# STORAGE_URL - Public URL to access storage files
# Example: https://yourdomain.com/storage
# Example with subdirectory: https://yourdomain.com/dev/storage
STORAGE_URL=

# STORAGE_PUBLIC_PATH - Absolute path to storage directory in public_html
# Example: /home/username/public_html/storage
# Example with subdirectory: /home/username/public_html/dev/storage
STORAGE_PUBLIC_PATH=

# Example Production Setup:
# Project location: /home/username/laravel_project/
# Public location: /home/username/public_html/dev/
# 
# STORAGE_URL=https://yourdomain.com/dev/storage
# STORAGE_PUBLIC_PATH=/home/username/public_html/dev/storage
#
# After setting these, run:
# php artisan storage:setup-directories
# php artisan storage:test

# ===========================================
# MAIL CONFIGURATION
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Alternative SMTP providers:
# Gmail: smtp.gmail.com (port 587, tls)
# Yahoo: smtp.mail.yahoo.com (port 587, tls)
# Outlook: smtp-mail.outlook.com (port 587, tls)
# Mailtrap: sandbox.smtp.mailtrap.io (port 2525)
# Mailgun: smtp.mailgun.org (port 587, tls)

# ===========================================
# AWS CONFIGURATION (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Rate Limiting (requests per minute)
RATE_LIMIT_WEB=120
RATE_LIMIT_ADMIN=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_DOWNLOAD=30
RATE_LIMIT_API=60

# DDoS Protection
DDOS_REQUESTS_PER_SECOND=10
DDOS_REQUESTS_PER_MINUTE=120
DDOS_REQUESTS_PER_HOUR=3000
DDOS_RAPID_FIRE_THRESHOLD=20
DDOS_SAME_ENDPOINT_THRESHOLD=30

# IP Blocking
SECURITY_BLOCK_THRESHOLD=10
SECURITY_BLOCK_DURATION=24
SECURITY_IP_WHITELIST=

# Session Security
SESSION_IDLE_TIMEOUT=30
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
