# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env on production server
# and update with your actual values

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
APP_NAME="Bank Syariah Babel"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://dev.bprsbabel.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpre3914_cms
DB_USERNAME=bpre3914_adminweb
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# ===========================================
# STORAGE CONFIGURATION (PRODUCTION)
# ===========================================
# Struktur Production:
# - Laravel Project: /home/bpre3914/app/
# - Public HTML: /home/bpre3914/public_html/
# - Symlink: /home/bpre3914/public_html/storage -> /home/bpre3914/app/storage/app/public

STORAGE_MODE=production
PRODUCTION_PUBLIC_PATH=/home/bpre3914/public_html
STORAGE_URL=https://dev.bprsbabel.id/storage

# Setup Steps:
# 1. Set values above
# 2. Run: php artisan storage:link-auto
# 3. Run: php artisan storage:test
# 4. Verify: ls -la /home/bpre3914/public_html/storage

# ===========================================
# SESSION & CACHE CONFIGURATION
# ===========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# MAIL CONFIGURATION
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# AWS CONFIGURATION (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Rate Limiting (requests per minute)
RATE_LIMIT_WEB=120
RATE_LIMIT_ADMIN=130
RATE_LIMIT_LOGIN=130
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_DOWNLOAD=30
RATE_LIMIT_API=60

# DDoS Protection
DDOS_REQUESTS_PER_SECOND=10
DDOS_REQUESTS_PER_MINUTE=120
DDOS_REQUESTS_PER_HOUR=3000
DDOS_RAPID_FIRE_THRESHOLD=20
DDOS_SAME_ENDPOINT_THRESHOLD=30

# IP Blocking
SECURITY_BLOCK_THRESHOLD=10
SECURITY_BLOCK_DURATION=24
SECURITY_IP_WHITELIST=

# Session Security
SESSION_IDLE_TIMEOUT=30
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
