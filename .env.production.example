# Production Environment Configuration
# Copy this to .env and update the values

APP_NAME="Bank Syariah Babel"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Rate Limiting (requests per minute)
RATE_LIMIT_WEB=120
RATE_LIMIT_ADMIN=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_DOWNLOAD=30
RATE_LIMIT_API=60

# DDoS Protection
DDOS_REQUESTS_PER_SECOND=10
DDOS_REQUESTS_PER_MINUTE=120
DDOS_REQUESTS_PER_HOUR=3000
DDOS_RAPID_FIRE_THRESHOLD=20
DDOS_SAME_ENDPOINT_THRESHOLD=30

# IP Blocking
SECURITY_BLOCK_THRESHOLD=10
SECURITY_BLOCK_DURATION=24
SECURITY_IP_WHITELIST=

# Session Security
SESSION_IDLE_TIMEOUT=30
SESSION_IDLE_WARNING=5
SESSION_IDLE_LOGOUT_ROUTE=login
SESSION_AUTO_EXTEND=true

# ===========================================
# PRODUCTION STORAGE CONFIGURATION
# ===========================================
# IMPORTANT: Update these values for your production server
#
# When Laravel project is OUTSIDE public_html:
# Project location: /home/username/laravel_project/
# Public location: /home/username/public_html/dev/
# Storage location: /home/username/public_html/dev/storage/
#
# STORAGE_URL - Public URL to access storage files
# Format: https://yourdomain.com/[subdirectory]/storage
STORAGE_URL=https://yourdomain.com/dev/storage

# STORAGE_ROOT_PATH - Absolute path where storage files will be accessible
# Format: /home/username/public_html/[subdirectory]/storage
STORAGE_ROOT_PATH=/home/username/public_html/dev/storage

# APP_PUBLIC_PATH - Subdirectory if index.php is not in root
# Example: dev (without slashes)
APP_PUBLIC_PATH=dev

# Example paths for different hosting setups:
# cPanel: /home/username/public_html/dev/storage
# VPS: /var/www/html/dev/storage
# Custom: /path/to/your/public_html/dev/storage
#
# After deployment, run these commands:
# php artisan storage:link-production  (creates symbolic link)
# php artisan storage:test             (tests configuration)
# php artisan config:clear             (clears config cache)
# php artisan cache:clear              (clears application cache)